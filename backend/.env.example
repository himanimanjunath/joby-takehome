# Local-only backend config for the take-home. No AWS, no Lakebase, no SSO.
# docker-compose.yml already injects these values for the `backend` service;
# this file documents them for running the API outside Docker.

# Local PostgreSQL (the compose `postgres` service)
PGHOST=localhost
PGPORT=5433
PGDATABASE=ebom
PGUSER=ebom
PGPASSWORD=ebom
PGSSLMODE=disable

# API
API_PREFIX=/api
